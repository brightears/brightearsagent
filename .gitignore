# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# macOS/iCloud/Finder sync-conflict copies ("foo 2.ts", "bar 2.sql") — never commit these
* [0-9].*
* [0-9]

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Dev email transport output
/.dev-outbox/

# Tutorial-video factory: generated media, browser auth, caches, and secrets
/tutorial/node_modules/
/tutorial/.auth/
/tutorial/**/.auth/
/tutorial/.cache/
/tutorial/.secrets/
/tutorial/output/
/tutorial/**/*.mp4
/tutorial/**/*.webm
/tutorial/**/*.wav
/tutorial/**/*.aiff
/tutorial/**/*.mp3
/tutorial/**/*.m4a
/tutorial/**/*storageState*.json
/tutorial/**/client_secret*.json
/tutorial/**/credentials*.json
/tutorial/**/*token*.json
